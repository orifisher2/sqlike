  },
  "license": "Apache-2.0",
  "bin": {
    "sqlike": "bin/sqlike.js"
  },
  "files": [
    "bin",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@sqlike/cli-darwin-arm64": "0.2.0",
    "@sqlike/cli-darwin-x64": "0.2.0",
    "@sqlike/cli-linux-arm64": "0.2.0",
    "@sqlike/cli-linux-x64": "0.2.0",
    "@sqlike/cli-win32-x64": "0.2.0"
  }
