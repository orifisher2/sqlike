{
  "name": "@sqlike/mcp",
  "mcpName": "io.github.orifisher2/sqlike-mcp",
  "version": "0.2.0",
  "description": "Gives an agent a second opinion on the SQL it writes: validity, anti-patterns, index advice, and whether a rewrite changed the results. Postgres, MySQL, MariaDB, SQLite, SQL Server and DuckDB. Queries are tokenized before they leave the machine.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "sql",
    "sqlike",
    "static-analysis",
    "postgres",
    "mysql",
    "sqlite",
    "sqlserver",
    "mariadb",
    "duckdb"
  ],
  "homepage": "https://sqlike.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orifisher2/sqlike.git",
    "directory": "packages/mcp"
  },
  "license": "Apache-2.0",
  "bin": {
    "sqlike-mcp": "bin/sqlike-mcp.js"
  },
  "files": [
    "bin",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@sqlike/mcp-darwin-arm64": "0.2.0",
    "@sqlike/mcp-darwin-x64": "0.2.0",
    "@sqlike/mcp-linux-arm64": "0.2.0",
    "@sqlike/mcp-linux-x64": "0.2.0",
    "@sqlike/mcp-win32-x64": "0.2.0"
  }
}
